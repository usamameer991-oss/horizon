{% doc %}
  @prompt
    i want to add custom size chart to custom products or collections of a proudct  create somethiing for that

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-{{ ai_gen_id }} {
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;}

  .ai-size-chart-trigger-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: {{ block.settings.trigger_color }};
    font-size: {{ block.settings.trigger_font_size }}px;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .ai-size-chart-trigger-{{ ai_gen_id }}:hover {
    color: {{ block.settings.trigger_hover_color }};
  }

  .ai-size-chart-trigger-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .ai-size-chart-modal-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding: 20px;
  }

  .ai-size-chart-modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-size-chart-modal-content-{{ ai_gen_id }} {
    background: {{ block.settings.modal_background }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    max-width: {{ block.settings.modal_max_width }}px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .ai-size-chart-modal-{{ ai_gen_id }}.active .ai-size-chart-modal-content-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-size-chart-modal-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 24px 16px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-size-chart-modal-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-size-chart-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    border-radius: 4px;
  }

  .ai-size-chart-close-{{ ai_gen_id }}:hover {
    opacity: 1;
    background-color: {{ block.settings.border_color }};
  }

  .ai-size-chart-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-size-chart-modal-body-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-size-chart-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_font_size }}px;
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .ai-size-chart-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }

  .ai-size-chart-table-{{ ai_gen_id }} th,
  .ai-size-chart-table-{{ ai_gen_id }} td {
    padding: 12px;
    text-align: left;
    border: 1px solid {{ block.settings.border_color }};
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.table_font_size }}px;
  }

  .ai-size-chart-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background }};
    font-weight: 600;
  }

  .ai-size-chart-table-{{ ai_gen_id }} tr:nth-child(even) {
    background-color: {{ block.settings.row_background }};
  }

  .ai-size-chart-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 16px;}

  .ai-size-chart-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;position: relative;
  }

  .ai-size-chart-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-size-chart-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;max-width: 300px;
    max-height: 150px;
  }

  .ai-size-chart-notes-{{ ai_gen_id }} {
    background-color: {{ block.settings.notes_background }};
    padding: 16px;
    border-radius: 8px;
    border-left: 4px solid {{ block.settings.trigger_color }};
  }

  .ai-size-chart-notes-{{ ai_gen_id }} h4 {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_font_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .ai-size-chart-notes-{{ ai_gen_id }} p {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_font_size }}px;
    margin: 0;line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .ai-size-chart-modal-content-{{ ai_gen_id }} {
      max-width: 95%;
      margin: 20px;
    }

    .ai-size-chart-modal-header-{{ ai_gen_id }},
    .ai-size-chart-modal-body-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-size-chart-table-{{ ai_gen_id }} {
      font-size: 12px;
    }

    .ai-size-chart-table-{{ ai_gen_id }} th,
    .ai-size-chart-table-{{ ai_gen_id }} td {
      padding: 8px 6px;
    }
  }
{% endstyle %}<size-chart-{{ ai_gen_id }}
  class="ai-size-chart-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign show_for_product = false
    assign show_for_collection = false

    if block.settings.target_products != blank
      for target_product in block.settings.target_products
        if target_product.id == product.id
          assign show_for_product = true
          break
        endif
      endfor
    endif

    if block.settings.target_collections != blank and show_for_product == false
      for target_collection in block.settings.target_collections
        if product.collections contains target_collection
          assign show_for_collection = true
          break
        endif
      endfor
    endif

    assign should_show = false
    if block.settings.target_products == blank and block.settings.target_collections == blank
      assign should_show = true
    elsif show_for_product or show_for_collection
      assign should_show = true
    endif
  %}

  {% if should_show %}
    <button
      class="ai-size-chart-trigger-{{ ai_gen_id }}"
      aria-label="Open size chart">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="M12 8v8"/>
        <path d="m8 12 4 4 4-4"/>
      </svg>
      {{ block.settings.trigger_text }}
    </button>

    <div class="ai-size-chart-modal-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-labelledby="size-chart-title-{{ ai_gen_id }}">
      <div class="ai-size-chart-modal-content-{{ ai_gen_id }}">
        <div class="ai-size-chart-modal-header-{{ ai_gen_id }}">
          <h2 id="size-chart-title-{{ ai_gen_id }}" class="ai-size-chart-modal-title-{{ ai_gen_id }}">
            {{ block.settings.modal_title }}
          </h2>
          <button
            class="ai-size-chart-close-{{ ai_gen_id }}"
            aria-label="Close size chart"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m18 6-1212"/>
              <path d="m6 6 12 12"/>
            </svg>
          </button>
        </div>

        <div class="ai-size-chart-modal-body-{{ ai_gen_id }}">
          {% if block.settings.description != blank %}
            <div class="ai-size-chart-description-{{ ai_gen_id }}">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.size_chart_image %}
            <img
              src="{{ block.settings.size_chart_image | image_url: width: 800}}"
              alt="{{ block.settings.size_chart_image.alt | escape }}"
              class="ai-size-chart-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.size_chart_image.width }}"
              height="{{ block.settings.size_chart_image.height }}"
            >
          {% else %}
            <div class="ai-size-chart-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-size-chart-empty-state-{{ ai_gen_id }}">
                Add a size chart image
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_table %}
            <table class="ai-size-chart-table-{{ ai_gen_id }}">
              <thead>
                <tr>
                  <th>{{ block.settings.size_header }}</th>
                  <th>{{ block.settings.measurement_1_header }}</th>
                  {% if block.settings.measurement_2_header != blank %}
                    <th>{{ block.settings.measurement_2_header }}</th>
                  {% endif %}
                  {% if block.settings.measurement_3_header != blank %}
                    <th>{{ block.settings.measurement_3_header }}</th>
                  {% endif %}
                </tr>
              </thead>
              <tbody>
                {% if block.settings.size_1 != blank %}
                  <tr>
                    <td>{{ block.settings.size_1 }}</td>
                    <td>{{ block.settings.size_1_measurement_1 }}</td>
                    {% if block.settings.measurement_2_header != blank %}
                      <td>{{ block.settings.size_1_measurement_2 }}</td>
                    {% endif %}
                    {% if block.settings.measurement_3_header != blank %}
                      <td>{{ block.settings.size_1_measurement_3 }}</td>
                    {% endif %}
                  </tr>
                {% endif %}
                {% if block.settings.size_2 != blank %}
                  <tr>
                    <td>{{ block.settings.size_2 }}</td>
                    <td>{{ block.settings.size_2_measurement_1 }}</td>
                    {% if block.settings.measurement_2_header != blank %}
                      <td>{{ block.settings.size_2_measurement_2 }}</td>
                    {% endif %}
                    {% if block.settings.measurement_3_header != blank %}
                      <td>{{ block.settings.size_2_measurement_3 }}</td>
                    {% endif %}
                  </tr>
                {% endif %}
                {% if block.settings.size_3 != blank %}
                  <tr>
                    <td>{{ block.settings.size_3 }}</td>
                    <td>{{ block.settings.size_3_measurement_1 }}</td>
                    {% if block.settings.measurement_2_header != blank %}
                      <td>{{ block.settings.size_3_measurement_2 }}</td>
                    {% endif %}
                    {% if block.settings.measurement_3_header != blank %}
                      <td>{{ block.settings.size_3_measurement_3 }}</td>
                    {% endif %}
                  </tr>
                {% endif %}
                {% if block.settings.size_4 != blank %}
                  <tr>
                    <td>{{ block.settings.size_4 }}</td>
                    <td>{{ block.settings.size_4_measurement_1 }}</td>
                    {% if block.settings.measurement_2_header != blank %}
                      <td>{{ block.settings.size_4_measurement_2 }}</td>
                    {% endif %}
                    {% if block.settings.measurement_3_header != blank %}
                      <td>{{ block.settings.size_4_measurement_3 }}</td>
                    {% endif %}
                  </tr>
                {% endif %}
                {% if block.settings.size_5 != blank %}
                  <tr>
                    <td>{{ block.settings.size_5 }}</td>
                    <td>{{ block.settings.size_5_measurement_1 }}</td>
                    {% if block.settings.measurement_2_header != blank %}
                      <td>{{ block.settings.size_5_measurement_2 }}</td>
                    {% endif %}
                    {% if block.settings.measurement_3_header != blank %}
                      <td>{{ block.settings.size_5_measurement_3 }}</td>
                    {% endif %}
                  </tr>
                {% endif %}
              </tbody>
            </table>
          {% endif %}

          {% if block.settings.notes != blank %}
            <div class="ai-size-chart-notes-{{ ai_gen_id }}">
              <h4>Sizing Notes</h4>
              {{ block.settings.notes }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</size-chart-{{ ai_gen_id }}><script>
  (function() {
    class SizeChart{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.trigger = this.querySelector('.ai-size-chart-trigger-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-size-chart-modal-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-size-chart-close-{{ ai_gen_id }}');

        if (this.trigger && this.modal && this.closeButton) {
          this.setupEventListeners();
        }
      }

      setupEventListeners() {
        this.trigger.addEventListener('click', () => {
          this.openModal();
        });

        this.closeButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.modal.addEventListener('click', (event) => {
          if (event.target === this.modal) {
            this.closeModal();
          }
        });document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal() {
        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.closeButton.focus();
      }

      closeModal() {
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
        this.trigger.focus();
      }
    }

    customElements.define('size-chart-{{ ai_gen_id }}', SizeChart{{ai_gen_id}});
  })();
</script>

