{% doc %}
  @prompt
    Create a minimalistic, premium Shopify section with a large, bold marquee text effect. The text should have a fully customizable fill color and optional stroke (outline) style with adjustable thickness and color. The marquee runs smoothly and continuously but is also scroll-triggered: when the user scrolls down, the text moves from left to right, and when scrolling up, it reverses direction. Make the animation GPU-optimized for buttery-smooth performance. Allow customization for font, size, weight, spacing, speed sensitivity to scroll, and padding. Add an option for repeating text with separators (e.g., dots, icons, or emojis) and adjustable gap. Include background color controls and a toggle for transparent backgrounds. Make it responsive so text scales elegantly on all devices. Keep the overall look clean, modern, and minimal, suitable for a luxury brand, while ensuring the code is clean, optimized, and accessible, no that not better i want i simple text other outlined text and make it fancy add different animations and stlyles and the speed of text fast when i scroll down and also the direction of text adjust, so first i want both type of text like outline and simple text and want to use both at same time in same line and secondly remove separator and also add adjust direction of text, also add uppercase letter and thin thick  text

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
    background: {% if block.settings.transparent_background %}transparent{% else %}{{ block.settings.background_color }}{% endif %};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    {% if block.settings.enable_gradient_bg %}
      background: linear-gradient({{ block.settings.gradient_angle }}deg, {{ block.settings.gradient_color_1 }}, {{ block.settings.gradient_color_2 }});
    {% endif %}
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    transform: translateX(0);
    {% if block.settings.animation_style == 'wave' %}
      animation: ai-wave-{{ ai_gen_id }} 3s ease-in-out infinite;
    {% elsif block.settings.animation_style == 'pulse' %}
      animation: ai-pulse-{{ ai_gen_id }} 2s ease-in-out infinite;
    {% elsif block.settings.animation_style == 'glow' %}
      animation: ai-glow-{{ ai_gen_id }} 2s ease-in-out infinite alternate;
    {% elsif block.settings.animation_style == 'bounce' %}
      animation: ai-bounce-{{ ai_gen_id }} 2s ease-in-out infinite;
    {% endif %}
  }

  .ai-marquee-text-group-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    margin-right: {{ block.settings.text_group_spacing }}px;
  }

  .ai-marquee-text-filled-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.filled_font_weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
    padding: 0;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    display: inline-block;
    position: relative;
    color: {{ block.settings.filled_text_color }};
    -webkit-text-fill-color: {{ block.settings.filled_text_color }};
    margin-right: {{ block.settings.text_spacing }}px;
    text-transform: {% if block.settings.filled_uppercase %}uppercase{% else %}none{% endif %};
    {% if block.settings.filled_text_shadow %}
      text-shadow: {{ block.settings.filled_shadow_x }}px {{ block.settings.filled_shadow_y }}px {{ block.settings.filled_shadow_blur }}px {{ block.settings.filled_shadow_color }};
    {% endif %}
    {% if block.settings.enable_3d_effect %}
      transform: perspective(500px) rotateX({{ block.settings.rotate_x }}deg) rotateY({{ block.settings.rotate_y }}deg);
    {% endif %}
    {% if block.settings.filled_italic %}
      font-style: italic;
    {% endif %}
  }

  .ai-marquee-text-outlined-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.outlined_font_weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
    padding: 0;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    display: inline-block;
    position: relative;
    color: transparent;
    -webkit-text-stroke: {{ block.settings.stroke_width }}px {{ block.settings.stroke_color }};
    text-stroke: {{ block.settings.stroke_width }}px {{ block.settings.stroke_color }};
    text-transform: {% if block.settings.outlined_uppercase %}uppercase{% else %}none{% endif %};
    {% if block.settings.enable_3d_effect %}
      transform: perspective(500px) rotateX({{ block.settings.rotate_x }}deg) rotateY({{ block.settings.rotate_y }}deg);
    {% endif %}
    {% if block.settings.outlined_italic %}
      font-style: italic;
    {% endif %}
  }

  .ai-marquee-text-thin-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.thin_font_weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
    padding: 0;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    display: inline-block;
    position: relative;
    color: {{ block.settings.thin_text_color }};
    -webkit-text-fill-color: {{ block.settings.thin_text_color }};
    margin-right: {{ block.settings.text_spacing }}px;
    text-transform: {% if block.settings.thin_uppercase %}uppercase{% else %}none{% endif %};
    {% if block.settings.thin_text_shadow %}
      text-shadow: {{ block.settings.thin_shadow_x }}px {{ block.settings.thin_shadow_y }}px {{ block.settings.thin_shadow_blur }}px {{ block.settings.thin_shadow_color }};
    {% endif %}
    {% if block.settings.enable_3d_effect %}
      transform: perspective(500px) rotateX({{ block.settings.rotate_x }}deg) rotateY({{ block.settings.rotate_y }}deg);
    {% endif %}
    {% if block.settings.thin_italic %}
      font-style: italic;
    {% endif %}
  }

  .ai-marquee-text-thick-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.thick_font_weight }};
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
    padding: 0;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    display: inline-block;
    position: relative;
    color: {{ block.settings.thick_text_color }};
    -webkit-text-fill-color: {{ block.settings.thick_text_color }};
    margin-right: {{ block.settings.text_spacing }}px;
    text-transform: {% if block.settings.thick_uppercase %}uppercase{% else %}none{% endif %};
    {% if block.settings.thick_text_shadow %}
      text-shadow: {{ block.settings.thick_shadow_x }}px {{ block.settings.thick_shadow_y }}px {{ block.settings.thick_shadow_blur }}px {{ block.settings.thick_shadow_color }};
    {% endif %}
    {% if block.settings.enable_3d_effect %}
      transform: perspective(500px) rotateX({{ block.settings.rotate_x }}deg) rotateY({{ block.settings.rotate_y }}deg);
    {% endif %}
    {% if block.settings.thick_italic %}
      font-style: italic;
    {% endif %}
  }

  @keyframes ai-wave-{{ ai_gen_id }} {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  @keyframes ai-pulse-{{ ai_gen_id }} {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @keyframes ai-glow-{{ ai_gen_id }} {
    0% { filter: brightness(1); }
    100% { filter: brightness(1.2); }
  }

  @keyframes ai-bounce-{{ ai_gen_id }} {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-15px); }
    60% { transform: translateY(-8px); }
  }

  @media screen and (max-width: 990px) {
    .ai-marquee-text-filled-{{ ai_gen_id }},
    .ai-marquee-text-outlined-{{ ai_gen_id }},
    .ai-marquee-text-thin-{{ ai_gen_id }},
    .ai-marquee-text-thick-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.7 }}px;
    }
    
    .ai-marquee-text-group-{{ ai_gen_id }} {
      margin-right: {{ block.settings.text_group_spacing | times: 0.7 }}px;
    }
    
    .ai-marquee-text-filled-{{ ai_gen_id }},
    .ai-marquee-text-thin-{{ ai_gen_id }},
    .ai-marquee-text-thick-{{ ai_gen_id }} {
      margin-right: {{ block.settings.text_spacing | times: 0.7 }}px;
    }
    
    .ai-marquee-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-text-filled-{{ ai_gen_id }},
    .ai-marquee-text-outlined-{{ ai_gen_id }},
    .ai-marquee-text-thin-{{ ai_gen_id }},
    .ai-marquee-text-thick-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.5 }}px;
      letter-spacing: {{ block.settings.letter_spacing | times: 0.7 }}px;
    }
    
    .ai-marquee-text-group-{{ ai_gen_id }} {
      margin-right: {{ block.settings.text_group_spacing | times: 0.5 }}px;
    }
    
    .ai-marquee-text-filled-{{ ai_gen_id }},
    .ai-marquee-text-thin-{{ ai_gen_id }},
    .ai-marquee-text-thick-{{ ai_gen_id }} {
      margin-right: {{ block.settings.text_spacing | times: 0.5 }}px;
    }
    
    .ai-marquee-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.5 }}px 0 {{ block.settings.padding_bottom | times: 0.5 }}px;
    }
  }
{% endstyle %}

<scroll-marquee-{{ ai_gen_id }}
  class="ai-marquee-container-{{ ai_gen_id }}"
  data-base-speed="{{ block.settings.base_speed }}"
  data-scroll-multiplier="{{ block.settings.scroll_speed_multiplier }}"
  data-direction="{{ block.settings.marquee_direction }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    {% for i in (1..block.settings.repeat_count) %}
      <div class="ai-marquee-text-group-{{ ai_gen_id }}">
        {% if block.settings.filled_text != blank and block.settings.show_filled_text %}
          <span class="ai-marquee-text-filled-{{ ai_gen_id }}">{{ block.settings.filled_text }}</span>
        {% endif %}
        {% if block.settings.outlined_text != blank and block.settings.show_outlined_text %}
          <span class="ai-marquee-text-outlined-{{ ai_gen_id }}">{{ block.settings.outlined_text }}</span>
        {% endif %}
        {% if block.settings.thin_text != blank and block.settings.show_thin_text %}
          <span class="ai-marquee-text-thin-{{ ai_gen_id }}">{{ block.settings.thin_text }}</span>
        {% endif %}
        {% if block.settings.thick_text != blank and block.settings.show_thick_text %}
          <span class="ai-marquee-text-thick-{{ ai_gen_id }}">{{ block.settings.thick_text }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</scroll-marquee-{{ ai_gen_id }}>

<script>
(function() {
  class ScrollMarquee{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.track = null;
      this.baseSpeed = 1;
      this.scrollMultiplier = 3;
      this.direction = 1;
      this.currentPosition = 0;
      this.lastScrollY = 0;
      this.scrollVelocity = 0;
      this.animationId = null;
      this.trackWidth = 0;
      this.containerWidth = 0;
      this.isScrolling = false;
      this.scrollTimeout = null;
    }

    connectedCallback() {
      this.track = this.querySelector('.ai-marquee-track-{{ ai_gen_id }}');
      this.baseSpeed = parseFloat(this.dataset.baseSpeed) || 1;
      this.scrollMultiplier = parseFloat(this.dataset.scrollMultiplier) || 3;
      
      const directionSetting = this.dataset.direction;
      if (directionSetting === 'left') {
        this.direction = -1;
      } else if (directionSetting === 'right') {
        this.direction = 1;
      } else {
        this.direction = 1;
      }
      
      this.setupMarquee();
      this.startAnimation();
      this.bindEvents();
    }

    disconnectedCallback() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
      window.removeEventListener('scroll', this.handleScroll);
      window.removeEventListener('resize', this.handleResize);
    }

    setupMarquee() {
      this.calculateDimensions();
      this.duplicateContent();
    }

    calculateDimensions() {
      this.containerWidth = this.offsetWidth;
      this.trackWidth = this.track.scrollWidth;
    }

    duplicateContent() {
      const originalContent = this.track.innerHTML;
      const duplicatesNeeded = Math.ceil((this.containerWidth * 4) / this.trackWidth) + 2;
      
      let duplicatedContent = originalContent;
      for (let i = 1; i < duplicatesNeeded; i++) {
        duplicatedContent += originalContent;
      }
      
      this.track.innerHTML = duplicatedContent;this.trackWidth = this.track.scrollWidth / duplicatesNeeded;
    }

    handleScroll = () => {
      const currentScrollY = window.pageYOffset;
      const scrollDelta = currentScrollY - this.lastScrollY;
      
      this.scrollVelocity = scrollDelta * this.scrollMultiplier;
      this.isScrolling = true;
      
      clearTimeout(this.scrollTimeout);
      this.scrollTimeout = setTimeout(() => {
        this.isScrolling = false;
        this.scrollVelocity *= 0.95;
      }, 50);
      
      this.lastScrollY = currentScrollY;
    }

    handleResize = () => {
      this.calculateDimensions();
      this.duplicateContent();
    }

    startAnimation() {
      const animate = () => {
        let speed = this.baseSpeed * this.direction;
        
        if (this.isScrolling) {
          speed += this.scrollVelocity * this.direction;
        } else {
          this.scrollVelocity *= 0.98;
          speed += this.scrollVelocity * this.direction;
        }
        
        this.currentPosition -= speed;
        
        if (this.currentPosition <= -this.trackWidth) {
          this.currentPosition += this.trackWidth;
        } else if (this.currentPosition >= this.trackWidth) {
          this.currentPosition -= this.trackWidth;
        }
        
        this.track.style.transform = `translateX(${this.currentPosition}px)`;
        
        this.animationId = requestAnimationFrame(animate);
      };
      
      animate();
    }

    bindEvents() {
      window.addEventListener('scroll', this.handleScroll, { passive: true });
      window.addEventListener('resize', this.handleResize, { passive: true });
    }
  }

  customElements.define('scroll-marquee-{{ ai_gen_id }}', ScrollMarquee{{ ai_gen_id }});
})();
</script>

