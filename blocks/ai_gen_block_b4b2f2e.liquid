{% doc %}
  @prompt
    Create a fully customizable Shopify homepage section with four product category blocks arranged in two rows. The top row should contain two equal-sized square blocks side-by-side. The bottom row should contain two portrait-style blocks (taller than they are wide), side-by-side. Allow me to adjust the aspect ratio of each block individually (square, portrait, or custom ratio) from the settings. Each block should display a high-quality image with a customizable overlay button that has editable text, link, colors, font size, and position (top, center, bottom). Add smooth hover effects like zoom-in, fade, or overlay color. The section should have adjustable spacing, margins, and padding. Make it fully responsive so that on mobile the blocks stack vertically with perfect scaling. The design should look modern, premium, and visually engaging, perfect for a luxury footwear brand. Ensure clean, optimized HTML/CSS/Liquid code for Shopify, turn overlay off and on oprion, First of all make the size of overal section small like when i scroll two images are on top and two are on the nect page mean page below fix it and also make the positions of all buttons adjust, you make it more small create a slider to adjust the height, i mean both width and heght make large like full sizee customization

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    margin: {{ block.settings.section_margin_top }}px auto {{ block.settings.section_margin_bottom }}px;
    width: {{ block.settings.section_width }}%;
    max-width: {{ block.settings.section_max_width }}px;
  }

  .ai-category-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
    height: {{ block.settings.section_height }}px;
  }

  .ai-category-block-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: transform 0.3s ease;
    width: 100%;
    height: 100%;
  }

  .ai-category-block-{{ ai_gen_id }}:hover {
    {% if block.settings.hover_effect == 'lift' %}
      transform: translateY(-8px);
    {% elsif block.settings.hover_effect == 'scale' %}
      transform: scale(1.02);
    {% endif %}
  }

  .ai-category-block__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-category-block-1-{{ ai_gen_id }} {
    width: {{ block.settings.block_1_width }}%;
    height: {{ block.settings.block_1_height }}%;
  }

  .ai-category-block-2-{{ ai_gen_id }} {
    width: {{ block.settings.block_2_width }}%;
    height: {{ block.settings.block_2_height }}%;
  }

  .ai-category-block-3-{{ ai_gen_id }} {
    width: {{ block.settings.block_3_width }}%;
    height: {{ block.settings.block_3_height }}%;
  }

  .ai-category-block-4-{{ ai_gen_id }} {
    width: {{ block.settings.block_4_width }}%;
    height: {{ block.settings.block_4_height }}%;
  }

  .ai-category-block-1-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.block_1_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.block_1_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.block_1_aspect_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.block_1_aspect_ratio == 'wide' %}
      aspect-ratio: 16 / 9;
    {% elsif block.settings.block_1_aspect_ratio == 'ultrawide' %}
      aspect-ratio: 21 / 9;
    {% else %}
      aspect-ratio: {{ block.settings.block_1_custom_width }} / {{ block.settings.block_1_custom_height }};
    {% endif %}
  }

  .ai-category-block-2-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.block_2_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.block_2_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.block_2_aspect_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.block_2_aspect_ratio == 'wide' %}
      aspect-ratio: 16 / 9;
    {% elsif block.settings.block_2_aspect_ratio == 'ultrawide' %}
      aspect-ratio: 21 / 9;
    {% else %}
      aspect-ratio: {{ block.settings.block_2_custom_width }} / {{ block.settings.block_2_custom_height }};
    {% endif %}
  }

  .ai-category-block-3-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.block_3_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.block_3_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.block_3_aspect_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.block_3_aspect_ratio == 'wide' %}
      aspect-ratio: 16 / 9;
    {% elsif block.settings.block_3_aspect_ratio == 'ultrawide' %}
      aspect-ratio: 21 / 9;
    {% else %}
      aspect-ratio: {{ block.settings.block_3_custom_width }} / {{ block.settings.block_3_custom_height }};
    {% endif %}
  }

  .ai-category-block-4-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.block_4_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.block_4_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.block_4_aspect_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.block_4_aspect_ratio == 'wide' %}
      aspect-ratio: 16 / 9;
    {% elsif block.settings.block_4_aspect_ratio == 'ultrawide' %}
      aspect-ratio: 21 / 9;
    {% else %}
      aspect-ratio: {{ block.settings.block_4_custom_width }} / {{ block.settings.block_4_custom_height }};
    {% endif %}
  }

  .ai-category-block__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-category-block__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-block__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-block-{{ ai_gen_id }}:hover .ai-category-block__image-{{ ai_gen_id }} {
    {% if block.settings.hover_effect == 'zoom' %}
      transform: scale(1.1);
    {% endif %}
  }

  {% if block.settings.show_overlay %}
    .ai-category-block__overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        135deg,
        {{ block.settings.overlay_color | color_modify: 'alpha', 0.0 }} 0%,
        {{ block.settings.overlay_color }} 100%
      );
      transition: opacity 0.3s ease;
      {% if block.settings.hover_effect == 'overlay' %}
        opacity: 0;
      {% else %}
        opacity: 1;
      {% endif %}
    }

    {% if block.settings.hover_effect == 'overlay' %}
      .ai-category-block-{{ ai_gen_id }}:hover .ai-category-block__overlay-{{ ai_gen_id }} {
        opacity: 1;
      }
    {% endif %}
  {% endif %}

  .ai-category-block__content-1-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: {{ block.settings.block_1_button_position }};
    justify-content: {{ block.settings.block_1_button_horizontal_position }};
    padding: 20px;
    z-index: 2;
  }

  .ai-category-block__content-2-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: {{ block.settings.block_2_button_position }};
    justify-content: {{ block.settings.block_2_button_horizontal_position }};
    padding: 20px;
    z-index: 2;
  }

  .ai-category-block__content-3-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: {{ block.settings.block_3_button_position }};
    justify-content: {{ block.settings.block_3_button_horizontal_position }};
    padding: 20px;
    z-index: 2;
  }

  .ai-category-block__content-4-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: {{ block.settings.block_4_button_position }};
    justify-content: {{ block.settings.block_4_button_horizontal_position }};
    padding: 20px;
    z-index: 2;
  }

  .ai-category-block__button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-category-block__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_section_width }}%;
      padding: {{ block.settings.mobile_section_padding }}px {{ block.settings.mobile_section_padding_horizontal }}px;
    }

    .ai-category-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, {{ block.settings.mobile_block_height }}px);
      gap: {{ block.settings.mobile_grid_gap }}px;
      height: auto;
    }

    .ai-category-block-1-{{ ai_gen_id }},
    .ai-category-block-2-{{ ai_gen_id }},
    .ai-category-block-3-{{ ai_gen_id }},
    .ai-category-block-4-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
    }

    .ai-category-block-1-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }},
    .ai-category-block-2-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }},
    .ai-category-block-3-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }},
    .ai-category-block-4-{{ ai_gen_id }} .ai-category-block__image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: auto;
      height: 100%;
    }

    .ai-category-block__content-1-{{ ai_gen_id }},
    .ai-category-block__content-2-{{ ai_gen_id }},
    .ai-category-block__content-3-{{ ai_gen_id }},
    .ai-category-block__content-4-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-category-block__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
      padding: {{ block.settings.mobile_button_padding }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }
  }
{% endstyle %}

<div class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__container-{{ ai_gen_id }}"><div class="ai-category-block-{{ ai_gen_id }} ai-category-block-1-{{ ai_gen_id }}">
      <div class="ai-category-block__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.block_1_image %}
          <img
            src="{{ block.settings.block_1_image | image_url: width: 800 }}"
            alt="{{ block.settings.block_1_image.alt | escape }}"
            class="ai-category-block__image-{{ ai_gen_id }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {% else %}
          <div class="ai-category-block__placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.show_overlay %}
          <div class="ai-category-block__overlay-{{ ai_gen_id }}"></div>
        {% endif %}
        <div class="ai-category-block__content-1-{{ ai_gen_id }}">
          {% if block.settings.block_1_button_text != blank %}
            <a
              href="{{ block.settings.block_1_button_link }}"
              class="ai-category-block__button-{{ ai_gen_id }}"
            >
              {{ block.settings.block_1_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-category-block-{{ ai_gen_id }} ai-category-block-2-{{ ai_gen_id }}">
      <div class="ai-category-block__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.block_2_image %}
          <img
            src="{{ block.settings.block_2_image | image_url: width: 800 }}"
            alt="{{ block.settings.block_2_image.alt | escape }}"
            class="ai-category-block__image-{{ ai_gen_id }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {% else %}
          <div class="ai-category-block__placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.show_overlay %}
          <div class="ai-category-block__overlay-{{ ai_gen_id }}"></div>
        {% endif %}
        <div class="ai-category-block__content-2-{{ ai_gen_id }}">
          {% if block.settings.block_2_button_text != blank %}
            <a
              href="{{ block.settings.block_2_button_link }}"
              class="ai-category-block__button-{{ ai_gen_id }}"
            >
              {{ block.settings.block_2_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-category-block-{{ ai_gen_id }} ai-category-block-3-{{ ai_gen_id }}">
      <div class="ai-category-block__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.block_3_image %}
          <img
            src="{{ block.settings.block_3_image | image_url: width: 800 }}"
            alt="{{ block.settings.block_3_image.alt | escape }}"
            class="ai-category-block__image-{{ ai_gen_id }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {% else %}
          <div class="ai-category-block__placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.show_overlay %}
          <div class="ai-category-block__overlay-{{ ai_gen_id }}"></div>
        {% endif %}
        <div class="ai-category-block__content-3-{{ ai_gen_id }}">
          {% if block.settings.block_3_button_text != blank %}
            <a
              href="{{ block.settings.block_3_button_link }}"
              class="ai-category-block__button-{{ ai_gen_id }}"
            >
              {{ block.settings.block_3_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-category-block-{{ ai_gen_id }} ai-category-block-4-{{ ai_gen_id }}">
      <div class="ai-category-block__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.block_4_image %}
          <img
            src="{{ block.settings.block_4_image | image_url: width: 800 }}"
            alt="{{ block.settings.block_4_image.alt | escape }}"
            class="ai-category-block__image-{{ ai_gen_id }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {% else %}
          <div class="ai-category-block__placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.show_overlay %}
          <div class="ai-category-block__overlay-{{ ai_gen_id }}"></div>
        {% endif %}
        <div class="ai-category-block__content-4-{{ ai_gen_id }}">
          {% if block.settings.block_4_button_text != blank %}
