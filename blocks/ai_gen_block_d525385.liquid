{% doc %}
  @prompt
    create a fancy countdown timer with  full features and make it mobile responsive same look but small size in mobile view

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-timer-{{ ai_gen_id }} {
    padding: 40px 20px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    position: relative;
    overflow: hidden;}

  .ai-countdown-timer-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
    pointer-events: none;
  }

  .ai-countdown-header-{{ ai_gen_id }} {
    margin-bottom: 30px;
    position: relative;
    z-index: 2;
  }

  .ai-countdown-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ai-countdown-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.8;
  }

  .ai-countdown-display-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 30px;position: relative;
    z-index: 2;
  }

  .ai-countdown-unit-{{ ai_gen_id }} {
    background: {{ block.settings.unit_background_color }};
    border-radius: {{ block.settings.unit_border_radius }}px;
    padding: 20px 15px;
    min-width: 80px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    border: 2px solid {{ block.settings.unit_border_color }};position: relative;
    overflow: hidden;
  }

  .ai-countdown-unit-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(145deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
    pointer-events: none;
  }

  .ai-countdown-number-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.number_size }}px;
    font-weight: 900;
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
  }

  .ai-countdown-label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    position: relative;
    z-index: 1;
  }

  .ai-countdown-expired-{{ ai_gen_id }} {
    display: none;
    color: {{ block.settings.expired_text_color }};
    font-size: {{ block.settings.expired_text_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    position: relative;
    z-index: 2;
  }

  .ai-countdown-expired-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-countdown-display-{{ ai_gen_id }}.expired {
    display: none;
  }

  .ai-countdown-progress-{{ ai_gen_id }} {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 20px;
    position: relative;
    z-index: 2;
  }

  .ai-countdown-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background: linear-gradient(90deg, {{ block.settings.progress_color_start }}, {{ block.settings.progress_color_end }});
    border-radius: 3px;
    transition: width 1s ease;
    width: 0%;}

  .ai-countdown-action-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-countdown-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 15px 30px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_border_color }};
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .ai-countdown-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  @media screen and (max-width: 768px) {
    .ai-countdown-timer-{{ ai_gen_id }} {
      padding: 25px 15px;}

    .ai-countdown-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-countdown-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-countdown-display-{{ ai_gen_id }} {
      gap: 10px;
      margin-bottom: 20px;
    }

    .ai-countdown-unit-{{ ai_gen_id }} {
      padding: 15px 10px;
      min-width: 60px;
    }

    .ai-countdown-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.7 }}px;margin-bottom: 5px;
    }

    .ai-countdown-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.8 }}px;
    }

    .ai-countdown-expired-{{ ai_gen_id }} {
      font-size: {{ block.settings.expired_text_size | times: 0.8 }}px;
    }

    .ai-countdown-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-countdown-display-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-countdown-unit-{{ ai_gen_id }} {
      padding: 12px 8px;
      min-width: 50px;
    }

    .ai-countdown-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.6 }}px;
    }

    .ai-countdown-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-timer-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  data-timezone="{{ block.settings.timezone }}"
  data-show-progress="{{ block.settings.show_progress }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-countdown-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    {% if block.settings.subtitle != blank %}
      <p class="ai-countdown-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="ai-countdown-display-{{ ai_gen_id }}">
    {% if block.settings.show_days %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <span class="ai-countdown-number-{{ ai_gen_id }}" data-unit="days">00</span>
        <span class="ai-countdown-label-{{ ai_gen_id }}">Days</span>
      </div>
    {% endif %}

    {% if block.settings.show_hours %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <span class="ai-countdown-number-{{ ai_gen_id }}" data-unit="hours">00</span>
        <span class="ai-countdown-label-{{ ai_gen_id }}">Hours</span>
      </div>
    {% endif %}

    {% if block.settings.show_minutes %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <span class="ai-countdown-number-{{ ai_gen_id }}" data-unit="minutes">00</span>
        <span class="ai-countdown-label-{{ ai_gen_id }}">Minutes</span>
      </div>
    {% endif %}

    {% if block.settings.show_seconds %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <span class="ai-countdown-number-{{ ai_gen_id }}" data-unit="seconds">00</span>
        <span class="ai-countdown-label-{{ ai_gen_id }}">Seconds</span>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_progress %}
    <div class="ai-countdown-progress-{{ ai_gen_id }}">
      <div class="ai-countdown-progress-bar-{{ ai_gen_id }}"></div>
    </div>
  {% endif %}

  <div class="ai-countdown-expired-{{ ai_gen_id }}">
    {{ block.settings.expired_message }}
  </div>

  {% if block.settings.button_text != blank and block.settings.button_url != blank %}
    <div class="ai-countdown-action-{{ ai_gen_id }}">
      <a href="{{ block.settings.button_url }}" class="ai-countdown-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    </div>
  {% endif %}
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.interval = null;
        this.endDateTime = null;
        this.startDateTime = null;
        this.totalDuration = null;
      }

      connectedCallback() {
        this.setupTimer();
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      setupTimer() {
        const endDate = this.dataset.endDate;
        const endTime = this.dataset.endTime || '23:59';
        const timezone = this.dataset.timezone || 'UTC';

        if (!endDate) return;

        try {
          const dateTimeString = `${endDate}T${endTime}:00`;
          this.endDateTime = new Date(dateTimeString);
          this.startDateTime = new Date();
          this.totalDuration = this.endDateTime.getTime() - this.startDateTime.getTime();

          if (isNaN(this.endDateTime.getTime())) {
            console.error('Invalid date format');
            return;
          }
        } catch (error) {
          console.error('Error parsing date:', error);
          return;
        }
      }

      startCountdown() {
        this.updateDisplay();
        this.interval = setInterval(() => {
          this.updateDisplay();
        }, 1000);
      }

      updateDisplay() {
        const now = new Date().getTime();
        const distance = this.endDateTime.getTime() - now;

        if (distance < 0) {
          this.showExpired();
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.updateUnit('days', days);
        this.updateUnit('hours', hours);
        this.updateUnit('minutes', minutes);
        this.updateUnit('seconds', seconds);

        if (this.dataset.showProgress === 'true') {
          this.updateProgress(distance);
        }
      }

      updateUnit(unit, value) {
        const element = this.querySelector(`[data-unit="${unit}"]`);
        if (element) {
          element.textContent = value.toString().padStart(2, '0');
        }
      }

      updateProgress(distance) {
        const progressBar = this.querySelector('.ai-countdown-progress-bar-{{ ai_gen_id }}');
        if (progressBar && this.totalDuration > 0) {
          const elapsed = this.totalDuration - distance;
          const percentage = Math.max(0, Math.min(100, (elapsed / this.totalDuration) * 100));
          progressBar.style.width = `${percentage}%`;
        }
      }

      showExpired() {
        if (this.interval) {
          clearInterval(this.interval);
        }

        const display = this.querySelector('.ai-countdown-display-{{ ai_gen_id }}');
        const expired = this.querySelector('.ai-countdown-expired-{{ ai_gen_id }}');

        if (display) display.classList.add('expired');
        if (expired) expired.classList.add('active');

        const progressBar = this.querySelector('.ai-countdown-progress-bar-{{ ai_gen_id }}');
        if (progressBar) {
          progressBar.style.width = '100%';
        }
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

