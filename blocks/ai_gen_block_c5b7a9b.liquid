{% doc %}
  @prompt
    Create a full-width Shopify announcement bar with a smooth marquee scrolling effect. Make it fully customizable from the theme editor, including background color, text color, border color/style, font size, scrolling speed, and direction. Add options to toggle border, adjust padding/margins, use gradient backgrounds, and include emojis or icons between messages. Marquee should pause on hover/touch and work smoothly on all devices. Use clean, optimized HTML, CSS, and Liquid so background and border colors always apply correctly, make it infinite like dont stop and alos make it fancy and minimilistic, i want to add option to pause on hover off and on

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    width: 100%;
    background: {% if block.settings.use_gradient %}linear-gradient(135deg, {{ block.settings.background_color }}, {{ block.settings.gradient_color }}){% else %}{{ block.settings.background_color }}{% endif %};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
    overflow: hidden;
    {% if block.settings.show_border %}
      border-top: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
      border-bottom: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    {% endif %}
    z-index: 10;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .ai-announcement-bar__track-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    animation-direction: {% if block.settings.scroll_direction == 'left' %}normal{% else %}reverse{% endif %};
    will-change: transform;
  }

  {% if block.settings.pause_on_hover %}
    .ai-announcement-bar__track-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }
  {% endif %}

  .ai-announcement-bar__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {% if block.settings.uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: 0 {{ block.settings.message_spacing }}px;
    position: relative;
  }

  .ai-announcement-bar__separator-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 {{ block.settings.separator_spacing }}px;
    font-size: {{ block.settings.separator_size }}px;
    opacity: {{ block.settings.separator_opacity | divided_by: 100.0 }};
    {% if block.settings.separator_style == 'dot' %}
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: currentColor;
    {% elsif block.settings.separator_style == 'line' %}
      width: 1px;
      height: {{ block.settings.font_size | times: 0.6 }}px;
      background-color: currentColor;
    {% endif %}
  }

  .ai-announcement-bar__glow-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    animation: ai-glow-{{ ai_gen_id }} 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes ai-marquee-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes ai-glow-{{ ai_gen_id }} {
    0%, 100% {
      left: -100%;
    }
    50% {
      left: 100%;
    }
  }

  {% if block.settings.pause_on_hover %}
    @media (hover: none) and (pointer: coarse) {
      .ai-announcement-bar__track-{{ ai_gen_id }}:active {
        animation-play-state: paused;
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px 0;
    }

    .ai-announcement-bar__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }

    .ai-announcement-bar__message-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.message_spacing | times: 0.8 }}px;
    }

    .ai-announcement-bar__separator-{{ ai_gen_id }} {
      margin: 0 {{ block.settings.separator_spacing | times: 0.8 }}px;
      font-size: {{ block.settings.separator_size | times: 0.9 }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-announcement-bar__track-{{ ai_gen_id }} {
      animation-duration: {{ block.settings.scroll_speed | times: 2 }}s;
    }
  }
{% endstyle %}

<announcement-marquee-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-pause-on-hover="{{ block.settings.pause_on_hover }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_glow %}
    <div class="ai-announcement-bar__glow-{{ ai_gen_id }}"></div>
  {% endif %}<div class="ai-announcement-bar__track-{{ ai_gen_id }}">
    {% assign messages = '' %}
    {% if block.settings.message_1 != blank %}
      {% assign messages = messages | append: block.settings.message_1 | append: '|' %}
    {% endif %}
    {% if block.settings.message_2 != blank %}
      {% assign messages = messages | append: block.settings.message_2 | append: '|' %}
    {% endif %}
    {% if block.settings.message_3 != blank %}
      {% assign messages = messages | append: block.settings.message_3 | append: '|' %}
    {% endif %}
    {% if block.settings.message_4 != blank %}
      {% assign messages = messages | append: block.settings.message_4 | append: '|' %}
    {% endif %}
    {% if block.settings.message_5 != blank %}
      {% assign messages = messages | append: block.settings.message_5 | append: '|' %}
    {% endif %}

    {% assign message_array = messages | split: '|' %}
    {% for i in (1..2) %}
      <div class="ai-announcement-bar__content-{{ ai_gen_id }}">
        {% for message in message_array %}
          {% if message != blank %}
            <span class="ai-announcement-bar__message-{{ ai_gen_id }}">{{ message }}</span>
            {% unless forloop.last %}
              {% if block.settings.separator_style == 'text' %}
                <span class="ai-announcement-bar__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
              {% elsif block.settings.separator_style == 'dot' %}
                <span class="ai-announcement-bar__separator-{{ ai_gen_id }}"></span>
              {% elsif block.settings.separator_style == 'line' %}
                <span class="ai-announcement-bar__separator-{{ ai_gen_id }}"></span>
              {% endif %}
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</announcement-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.isTouch = false;
        this.observer = null;
        this.pauseOnHover = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-announcement-bar__track-{{ ai_gen_id }}');
        this.pauseOnHover = this.dataset.pauseOnHover === 'true';
        
        if (this.track) {
          this.setupTouchEvents();
          this.setupIntersectionObserver();
          this.optimizeAnimation();
        }
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }

      setupTouchEvents() {
        if (this.pauseOnHover) {
          this.addEventListener('touchstart', () => {
            this.isTouch = true;
            this.track.style.animationPlayState = 'paused';
          }, { passive: true });

          this.addEventListener('touchend', () => {
            this.track.style.animationPlayState = 'running';
            setTimeout(() => {
              this.isTouch = false;
            }, 100);
          }, { passive: true });

          this.addEventListener('mouseenter', () => {
            if (!this.isTouch) {
              this.track.style.animationPlayState = 'paused';
            }
          });

          this.addEventListener('mouseleave', () => {
            if (!this.isTouch) {
              this.track.style.animationPlayState = 'running';
            }
          });
        }
      }

      setupIntersectionObserver() {
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.track.style.animationPlayState = 'running';
            } else {
              this.track.style.animationPlayState = 'paused';
            }
          });
        }, { threshold: 0.1 });

        this.observer.observe(this);
      }

      optimizeAnimation() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          this.track.style.animationDuration = '{{ block.settings.scroll_speed | times: 3 }}s';
        }
      }
    }

    customElements.define('announcement-marquee-{{ ai_gen_id }}', AnnouncementMarquee{{ ai_gen_id }});
  })();
</script>

