      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Vertical position",
      "default": 50
    },
    {
      "type": "select",
      "id": "men_button_animation",
      "label": "Hover animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "slide_up",
