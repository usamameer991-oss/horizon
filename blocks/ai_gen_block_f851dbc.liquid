{% doc %}
  @prompt
    want to generate a slidshow hero section which has also option for uploading image in mobile resoultion it should be responsive make it fancyy responsive and add overlay, change mobile and desktop height in pixels and also give recommended height on which image to use

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    overflow: hidden;
    background-color: #000;
  }

  .ai-slideshow-hero-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
  }

  .ai-slideshow-hero-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-hero-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-hero-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-slideshow-hero-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    z-index: 1;
  }

  .ai-slideshow-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-slideshow-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-slideshow-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
    max-width: 800px;
    padding: 0 20px;
    width: 100%;
  }

  .ai-slideshow-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-slideshow-hero-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0 0 24px;
    line-height: 1.4;
    opacity: 0.9;
  }

  .ai-slideshow-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_color }};
  }

  .ai-slideshow-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .ai-slideshow-hero-navigation-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 4;
  }

  .ai-slideshow-hero-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
  }

  .ai-slideshow-hero-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.accent_color }};
    transform: scale(1.2);
  }

  .ai-slideshow-hero-arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.2);
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .ai-slideshow-hero-arrows-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-50%) scale(1.1);
  }

  .ai-slideshow-hero-arrow-prev-{{ ai_gen_id }} {
    left: 30px;
  }

  .ai-slideshow-hero-arrow-next-{{ ai_gen_id }} {
    right: 30px;
  }

  .ai-slideshow-hero-arrows-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: white;
  }

  @media screen and (max-width: 768px) {
    .ai-slideshow-hero-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-slideshow-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-slideshow-hero-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-slideshow-hero-button-{{ ai_gen_id }} {
      padding: 14px 28px;
      font-size: 14px;
    }

    .ai-slideshow-hero-arrows-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-slideshow-hero-arrow-prev-{{ ai_gen_id }} {
      left: 15px;
    }

    .ai-slideshow-hero-arrow-next-{{ ai_gen_id }} {
      right: 15px;
    }

    .ai-slideshow-hero-arrows-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }

    .ai-slideshow-hero-navigation-{{ ai_gen_id }} {
      bottom: 20px;
    }

    .ai-slideshow-hero-content-{{ ai_gen_id }} {
      padding: 0 15px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-slideshow-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-slideshow-hero-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<slideshow-hero-{{ ai_gen_id }}
  class="ai-slideshow-hero-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-slideshow-hero-container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
        assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
        assign title_key = 'slide_' | append: i | append: '_title'
        assign subtitle_key = 'slide_' | append: i | append: '_subtitle'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign desktop_image = block.settings[desktop_image_key]
        assign mobile_image = block.settings[mobile_image_key]
        assign title = block.settings[title_key]
        assign subtitle = block.settings[subtitle_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
      %}

      {% if slide_enabled %}
        <div
          class="ai-slideshow-hero-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide="{{ forloop.index0 }}"
        >
          {% if desktop_image %}
            <picture>
              {% if mobile_image %}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ mobile_image | image_url: width: 800 }} 800w, {{ mobile_image | image_url: width: 1200 }} 1200w"
                >
              {% endif %}
              <img
                src="{{ desktop_image | image_url: width: 1920 }}"
                srcset="{{ desktop_image | image_url: width: 1200 }} 1200w, {{ desktop_image | image_url: width: 1920 }} 1920w, {{ desktop_image | image_url: width: 2400 }} 2400w"
                alt="{{ desktop_image.alt | escape }}"
                class="ai-slideshow-hero-image-{{ ai_gen_id }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
              >
            </picture>
          {% else %}
            <div class="ai-slideshow-hero-image-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-slideshow-hero-overlay-{{ ai_gen_id }}"></div>

          <div class="ai-slideshow-hero-content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h1 class="ai-slideshow-hero-title-{{ ai_gen_id }}">{{ title }}</h1>
            {% endif %}
            {% if subtitle != blank %}
              <p class="ai-slideshow-hero-subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
            {% endif %}
            {% if button_text != blank and button_link != blank %}
              <a href="{{ button_link }}" class="ai-slideshow-hero-button-{{ ai_gen_id }}">
                {{ button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% assign active_slides = 0 %}
  {% for i in (1..5) %}
    {% liquid
      assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
      assign slide_enabled = block.settings[slide_enabled_key]
    %}
    {% if slide_enabled %}
      {% assign active_slides = active_slides | plus: 1 %}
    {% endif %}
  {% endfor %}

  {% if active_slides > 1 %}
    {% if block.settings.show_arrows %}
      <button class="ai-slideshow-hero-arrows-{{ ai_gen_id }} ai-slideshow-hero-arrow-prev-{{ ai_gen_id }}" aria-label="Previous slide">
        <svg viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>
      <button class="ai-slideshow-hero-arrows-{{ ai_gen_id }} ai-slideshow-hero-arrow-next-{{ ai_gen_id }}" aria-label="Next slide">
        <svg viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-slideshow-hero-navigation-{{ ai_gen_id }}">
        {% assign dot_index = 0 %}
        {% for i in (1..5) %}
          {% liquid
            assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
            assign slide_enabled = block.settings[slide_enabled_key]
          %}
          {% if slide_enabled %}
            <button
              class="ai-slideshow-hero-dot-{{ ai_gen_id }} {% if dot_index == 0 %}active{% endif %}"
              data-slide="{{ dot_index }}"
              aria-label="Go to slide {{ dot_index | plus: 1 }}"
            ></button>
            {% assign dot_index = dot_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</slideshow-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class SlideshowHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.dots = [];
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-hero-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-hero-dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-hero-arrow-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-slideshow-hero-arrow-next-{{ ai_gen_id }}');
        
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        this.setupEventListeners();
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') this.previousSlide();
          if (e.key === 'ArrowRight') this.nextSlide();
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        if (this.autoplay && this.slides.length > 1) {
          this.autoplayTimer = setInterval(() => {
            this.nextSlide();
          }, this.autoplaySpeed);
        }
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }
    }

    customElements.define('slideshow-hero-{{ ai_gen_id }}', SlideshowHero{{ ai_gen_id }});
  })();
</script>

